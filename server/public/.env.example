# Copy to .env. Everything here is required for a real run; the ingest path
# fails at the first LLM call without them, and that failure is swallowed
# per-episode ("N episodes failed and stay pending") rather than raised.

# ── Slack ingress ────────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=          # Basic Information -> App Credentials
SLACK_BOT_TOKEN=xoxb-          # OAuth & Permissions -> after Install to Workspace
VERIFY_TIMESTAMP=true          # false only while replaying through ngrok

# ── src/inject ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=                # coref extraction + merge review

# The app must NOT connect as `postgres`: it carries BYPASSRLS, so no tenant
# wall applies. Use a login role, and issue `SET LOCAL ROLE` per transaction --
# see CLAUDE.md "Database access".
#   app_ingest_login     uploads and backfills (declares app.tenant_id)
#   app_connector_login  anything with a workspace (app.connector + app.workspace_id)
#   app_ack_login        the public webhook endpoint, nothing else
# Passwords are set out of band; the migration creates these roles without one.
DATABASE_URL=postgresql://app_ingest_login:PASSWORD@HOST:5432/postgres
