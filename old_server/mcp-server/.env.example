# Set these as Railway service variables in production.

# OpenAI — query embeddings (text-embedding-3-large)
OPENAI_API_KEY=

# Neo4j (Aura)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Required — server refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Optional
DEFAULT_GROUP_ID=testing-1
# PORT is injected by Railway; MCP_PORT is the local-dev fallback (8848)
